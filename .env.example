# Copy to .env.local. Never commit the resulting file or a real API key.

# OpenAI API credential:
LLM_API_KEY=replace-with-provider-key

# For a local OpenAI-compatible vLLM server, set its base URL. The agent uses a
# placeholder key when LLM_BASE_URL is set and LLM_API_KEY is empty.
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=

# Replace this sample directory with administrator-approved, read-only data
# sources on the host where DIRAC is installed.
# DIRAC_MCP_DATA_DIR=/approved/dirac/diagnostic-data
